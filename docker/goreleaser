FROM alpine:3.21
ARG TARGETPLATFORM
RUN apk add --no-cache ca-certificates tzdata sqlite-libs && \
    addgroup -g 65532 -S alita && \
    adduser -u 65532 -S alita -G alita && \
    mkdir -p /data && \
    chown -R alita:alita /data
WORKDIR /app
COPY $TARGETPLATFORM/alita_robot /app/
RUN chown alita:alita /app/alita_robot
USER alita:alita
VOLUME ["/data"]
EXPOSE 8080
ENTRYPOINT ["/app/alita_robot"]
